# Copy to `.env` and fill in values.
# Loaded automatically from repo root (see `llm.env_file` in config.yaml).

# `lens render` LLM provider. Fill in ONE key; if several are set the first populated wins
# (Anthropic > OpenAI > Mistral). Models are set in config.yaml (llm.*_model).
# Only the question and the retrieved excerpts are sent to the provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=

# Optional: force a provider when several keys are set (anthropic | openai | mistral).
LLM_PROVIDER=
