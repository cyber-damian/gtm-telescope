# Copy to `.env` and fill in values.
# Loaded automatically from repo root (see `llm.env_file` in config.yaml).

# Only needed for HOSTED LLM endpoints (e.g. llm.base_url: https://api.openai.com/v1).
# The default local server (Ollama at http://localhost:11434/v1) needs no key.
# Hosted endpoints receive only the question and the retrieved excerpts.
OPENAI_API_KEY=
